// 우리 반 담벼락의 역할별 Firestore 보안 규칙입니다.
// users/{uid} 문서의 role은 teacher 또는 student를 사용합니다.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";
    }

    function validNewMemo() {
      return request.resource.data.keys().hasOnly(["text", "createdAt", "uid"])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 50
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.uid is string;
    }

    function validUpdatedMemo() {
      return request.resource.data.keys().hasOnly(["text", "createdAt", "uid"])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 50
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.uid == resource.data.uid;
    }

    match /memos/{docId} {
      // 로그인한 교사와 학생은 담벼락을 읽을 수 있습니다.
      allow read: if signedIn();

      // 학생은 자신의 uid로만 메모를 만들 수 있습니다.
      // 교사는 모든 메모를 만들 수 있습니다.
      allow create: if validNewMemo()
        && (isTeacher() || request.resource.data.uid == request.auth.uid);

      // 수정과 삭제는 교사만 할 수 있습니다.
      allow update: if isTeacher() && validUpdatedMemo();
      allow delete: if isTeacher();
    }

    match /users/{userId} {
      // 사용자는 자신의 역할을 확인하고, 교사는 전체 역할을 확인할 수 있습니다.
      allow read: if signedIn() && (request.auth.uid == userId || isTeacher());

      // 역할 지정은 Firebase Console 또는 신뢰할 수 있는 서버에서만 합니다.
      allow write: if false;
    }
  }
}
