// Firestore security rules for class-wall project
// 메모를 저장할 때, 텍스트 길이가 5글자 이상이어야 합니다.
// 읽기는 모두 허용합니다.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // memos 컬렉션에 대한 규칙
    match /memos/{docId} {
      // 읽기 허용
      allow read: if true;
      // 생성 및 업데이트는 텍스트 길이가 5이상일 때만 허용
      allow create, update: if request.resource.data.text.size() >= 5;
      // 삭제는 현재 정책에 따라 허용 (필요 시 제한 가능)
      allow delete: if true;
    }
  }
}
